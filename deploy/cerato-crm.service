[Unit]
Description=Cerato CRM API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=cerato-crm
Group=cerato-crm
WorkingDirectory=/opt/cerato-crm/app
EnvironmentFile=/etc/cerato-crm.env
ExecStart=/opt/cerato-crm/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=HOME=/opt/cerato-crm
Environment=CODEX_HOME=/opt/cerato-crm/.codex
ReadWritePaths=/opt/cerato-crm/.codex

[Install]
WantedBy=multi-user.target
